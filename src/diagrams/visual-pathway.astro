---
/* Original schematic: the visual pathway seen from above (anterior at the top, patient's left on the
   viewer's left), with six classic lesion sites on the left side and the visual field defect each
   produces. Fibers carrying the right visual field are amber (they end in the left hemisphere);
   fibers carrying the left visual field are blue. */
import Label from '../components/Label.astro';

const AMBER = '#f59e0b';
const BLUE = '#60a5fa';
const R = 26; // field circle radius
const LX = 830; // left-eye field column
const RX = 906; // right-eye field column
const half = (cx: number, cy: number, side: 'L' | 'R') =>
  `M${cx} ${cy - R} A${R} ${R} 0 0 ${side === 'R' ? 1 : 0} ${cx} ${cy + R} Z`;
const quad = (cx: number, cy: number, q: 'RU' | 'RD') =>
  q === 'RU' ? `M${cx} ${cy} L${cx} ${cy - R} A${R} ${R} 0 0 1 ${cx + R} ${cy} Z` : `M${cx} ${cy} L${cx + R} ${cy} A${R} ${R} 0 0 1 ${cx} ${cy + R} Z`;
const full = (cx: number, cy: number) => `M${cx - R} ${cy} A${R} ${R} 0 1 0 ${cx + R} ${cy} A${R} ${R} 0 1 0 ${cx - R} ${cy} Z`;
const rows = [
  { n: 1, site: 'Left optic nerve', defect: 'Left monocular blindness', l: [full(LX, 0)], r: [] },
  { n: 2, site: 'Optic chiasm', defect: 'Bitemporal hemianopia', l: [half(LX, 0, 'L')], r: [half(RX, 0, 'R')] },
  { n: 3, site: 'Left optic tract', defect: 'Right homonymous hemianopia', l: [half(LX, 0, 'R')], r: [half(RX, 0, 'R')] },
  { n: 4, site: 'Left Meyer loop (temporal)', defect: 'Right superior quadrantanopia', l: [quad(LX, 0, 'RU')], r: [quad(RX, 0, 'RU')] },
  { n: 5, site: 'Left parietal radiation', defect: 'Right inferior quadrantanopia', l: [quad(LX, 0, 'RD')], r: [quad(RX, 0, 'RD')] },
  { n: 6, site: 'Left occipital cortex (PCA)', defect: 'Right hemianopia, macula spared', l: [half(LX, 0, 'R')], r: [half(RX, 0, 'R')], macula: true },
];
const rowY = (i: number) => 96 + i * 88;
// lesion markers on the pathway: bar endpoints and number position
const lesions = [
  { bar: [164, 150, 214, 150], nx: 146, ny: 155 },
  { bar: [230, 176, 230, 216], nx: 214, ny: 226 },
  { bar: [160, 246, 198, 266], nx: 146, ny: 262 },
  { bar: [62, 378, 104, 378], nx: 52, ny: 383 },
  { bar: [146, 423, 180, 423], nx: 196, ny: 428 },
  { bar: [170, 566, 210, 586], nx: 150, ny: 594 },
];
---

<div class="scroll">
  <svg viewBox="0 0 960 650" role="img" aria-labelledby="vp-title vp-desc">
    <title id="vp-title">Visual pathway and visual field defects</title>
    <desc id="vp-desc">
      View from above. Fibers from the nasal half of each retina cross at the optic chiasm, so each optic tract carries
      the opposite visual field to the lateral geniculate nucleus of the thalamus. Optic radiations run to the occipital
      cortex: the lower fibers loop through the temporal lobe (Meyer loop) and carry the upper visual field; the upper
      fibers pass through the parietal lobe and carry the lower field. Lesions: 1, left optic nerve — left monocular
      blindness; 2, chiasm — bitemporal hemianopia; 3, left optic tract — right homonymous hemianopia; 4, left Meyer loop
      — right superior quadrantanopia; 5, left parietal radiation — right inferior quadrantanopia; 6, left occipital
      cortex — right homonymous hemianopia with macular sparing.
    </desc>
    <style>
      .vp-brain { fill: color-mix(in srgb, var(--muted) 8%, transparent); stroke: var(--muted); stroke-width: 1.2; }
      .vp-mid { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 5 5; }
      .vp-eye { fill: var(--surface); stroke: var(--text); stroke-width: 2; }
      .vp-f { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
      .vp-dash { stroke-dasharray: 8 5; }
      .vp-lgn { fill: color-mix(in srgb, var(--t-organ) 45%, var(--surface)); stroke: var(--t-organ); stroke-width: 1.5; }
      .vp-les { stroke: #ef4444; stroke-width: 6; stroke-linecap: round; }
      .vp-num { fill: #ef4444; font-weight: 700; font-size: 17px; }
      .vp-field { fill: var(--surface); stroke: var(--text); stroke-width: 1.5; }
      .vp-lost { fill: #ef4444; opacity: 0.7; }
      .vp-sep { stroke: var(--muted); stroke-width: 0.8; opacity: 0.5; }
    </style>

    <!-- brain outline and midline -->
    <ellipse class="vp-brain" cx="230" cy="392" rx="206" ry="236"></ellipse>
    <line class="vp-mid" x1="230" y1="160" x2="230" y2="628"></line>

    <!-- eyes -->
    <circle class="vp-eye" cx="150" cy="78" r="30"></circle>
    <circle class="vp-eye" cx="310" cy="78" r="30"></circle>

    <!-- fibers: right visual field (amber) → left hemisphere; left visual field (blue) → right hemisphere -->
    <path class="vp-f" stroke={AMBER} d="M132 104 L214 196 L200 214 L152 296"></path>
    <path class="vp-f" stroke={AMBER} d="M292 104 L214 204 L204 216 L156 298"></path>
    <path class="vp-f" stroke={BLUE} d="M168 104 L246 204 L256 216 L304 298"></path>
    <path class="vp-f" stroke={BLUE} d="M328 104 L246 196 L260 214 L308 296"></path>

    <!-- LGN -->
    <ellipse class="vp-lgn" cx="154" cy="302" rx="14" ry="9"></ellipse>
    <ellipse class="vp-lgn" cx="306" cy="302" rx="14" ry="9"></ellipse>

    <!-- optic radiations: Meyer loop (solid, temporal) and parietal fibers (dashed) -->
    <path class="vp-f" stroke={AMBER} d="M150 310 C 50 320, 60 440, 170 530 L 188 566"></path>
    <path class="vp-f vp-dash" stroke={AMBER} d="M156 310 C 150 380, 170 460, 192 566"></path>
    <path class="vp-f" stroke={BLUE} d="M310 310 C 410 320, 400 440, 290 530 L 272 566"></path>
    <path class="vp-f vp-dash" stroke={BLUE} d="M304 310 C 310 380, 290 460, 268 566"></path>

    <!-- primary visual cortex -->
    <ellipse cx="190" cy="580" rx="32" ry="14" fill={AMBER} opacity="0.35"></ellipse>
    <ellipse cx="270" cy="580" rx="32" ry="14" fill={BLUE} opacity="0.35"></ellipse>

    <!-- lesions -->
    {lesions.map((l, i) => (
      <>
        <line class="vp-les" x1={l.bar[0]} y1={l.bar[1]} x2={l.bar[2]} y2={l.bar[3]}></line>
        <text class="vp-num" x={l.nx} y={l.ny} text-anchor="middle">{i + 1}</text>
      </>
    ))}

    <!-- leader lines for right-side labels -->
    <g stroke="var(--muted)" stroke-width="1">
      <line x1="446" y1="146" x2="296" y2="146"></line>
      <line x1="446" y1="198" x2="244" y2="200"></line>
      <line x1="446" y1="252" x2="286" y2="256"></line>
      <line x1="446" y1="302" x2="322" y2="302"></line>
      <line x1="446" y1="372" x2="380" y2="380"></line>
      <line x1="446" y1="440" x2="300" y2="430"></line>
      <line x1="446" y1="580" x2="302" y2="580"></line>
    </g>

    <Label x={110} y={50} anchor="end" size="sm" to="eyeball">Left eye</Label>
    <Label x={350} y={50} size="sm" to="eyeball">Right eye</Label>
    <Label x={452} y={150} size="sm" to="optic-nerve">Optic nerve</Label>
    <Label x={452} y={202} size="sm" to="optic-nerve">Optic chiasm</Label>
    <Label x={452} y={256} size="sm" to="optic-nerve">Optic tract</Label>
    <Label x={452} y={306} size="sm" to="thalamus">LGN (thalamus)</Label>
    <Label x={452} y={370} size="sm" to="optic-nerve">Meyer loop</Label>
    <Label x={452} y={384} size="sm">(temporal lobe → upper field)</Label>
    <Label x={452} y={440} size="sm">Parietal radiation (dashed)</Label>
    <Label x={452} y={454} size="sm">(→ lower field)</Label>
    <Label x={452} y={584} size="sm" to="cerebral-cortex">V1 (occipital lobe)</Label>

    <!-- field table -->
    <Label x={LX} y={48} anchor="middle" size="sm">Left eye</Label>
    <Label x={RX} y={48} anchor="middle" size="sm">Right eye</Label>
    <Label x={590} y={30} size="sm">Lesion → visual field (patient's view; red = lost)</Label>
    {rows.map((row, i) => {
      const y = rowY(i);
      return (
        <g>
          <line class="vp-sep" x1="578" y1={y + 44} x2="946" y2={y + 44}></line>
          <text class="vp-num" x="592" y={y + 5} text-anchor="middle">{row.n}</text>
          <Label x={608} y={y - 4} size="sm">{row.site}</Label>
          <Label x={608} y={y + 13} size="sm">{row.defect}</Label>
          <circle class="vp-field" cx={LX} cy={y} r={R}></circle>
          <circle class="vp-field" cx={RX} cy={y} r={R}></circle>
          <g transform={`translate(0 ${y})`}>
            {row.l.map((d) => <path class="vp-lost" d={d}></path>)}
            {row.r.map((d) => <path class="vp-lost" d={d}></path>)}
            {row.macula && (
              <>
                <circle cx={LX} cy="0" r="7" fill="var(--surface)"></circle>
                <circle cx={RX} cy="0" r="7" fill="var(--surface)"></circle>
              </>
            )}
          </g>
        </g>
      );
    })}

    <Label x={10} y={640} size="sm">Amber = right visual field (→ left hemisphere) · Blue = left visual field (→ right hemisphere) · Red bars = lesion sites</Label>
  </svg>
</div>
<p class="scroll-hint">Swipe sideways to see the whole diagram →</p>
