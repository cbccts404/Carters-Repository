---
/* Original schematic: suboccipital region, posterior view, after removal of trapezius, splenius and semispinalis
   capitis. Midline at x = 330; the muscles are drawn on both sides, the contents on the right side only.
   Not to scale. */
import Label from '../components/Label.astro';

const M = 330; // midline
const mirror = `translate(${2 * M} 0) scale(-1 1)`;
---

<div class="scroll">
  <svg viewBox="-200 20 1110 420" role="img" aria-labelledby="so-title so-desc">
    <title id="so-title">Suboccipital triangle (posterior view)</title>
    <desc id="so-desc">
      Posterior view of the upper neck with the superficial muscles removed. On each side, rectus capitis posterior
      major runs from the spinous process of the axis up to the occipital bone, obliquus capitis inferior runs from
      the spinous process of the axis out to the transverse process of the atlas, and obliquus capitis superior runs
      from the transverse process of the atlas up to the occipital bone. These three muscles bound the suboccipital
      triangle. Rectus capitis posterior minor lies medially, from the posterior tubercle of the atlas to the
      occiput. In the floor of the triangle, the vertebral artery runs medially along the posterior arch of the atlas,
      with the suboccipital nerve emerging between them. The greater occipital nerve winds around the lower border of
      obliquus capitis inferior and ascends medial to the triangle.
    </desc>
    <style>
      .so-bone { fill: color-mix(in srgb, var(--t-bone) 22%, var(--surface)); stroke: var(--t-bone); stroke-width: 2; }
      .so-arch { stroke: var(--t-bone); stroke-width: 12; stroke-linecap: round; fill: none; }
      .so-mus { fill: color-mix(in srgb, var(--t-muscle) 32%, transparent); stroke: var(--t-muscle); stroke-width: 1.8; }
      .so-tri { fill: color-mix(in srgb, var(--t-space) 20%, transparent); stroke: var(--t-space); stroke-width: 1.5; stroke-dasharray: 5 4; }
      .so-art { stroke: var(--t-artery); stroke-width: 5; stroke-linecap: round; fill: none; }
      .so-nerve { stroke: var(--t-nerve); stroke-width: 2.5; stroke-linecap: round; fill: none; }
      .so-gon { stroke: var(--t-nerve); stroke-width: 3.5; stroke-linecap: round; fill: none; }
      .so-mid { stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 6 5; }
    </style>

    <!-- occipital bone with mastoid processes; lower border ≈ inferior nuchal line region -->
    <path class="so-bone" d={`M60 150 L60 96 Q330 16 600 96 L600 150 Q596 190 584 196 Q566 170 540 140 Q${M} 158 120 140 Q94 170 76 196 Q64 190 60 150 Z`}></path>

    <!-- atlas (C1): posterior arch and transverse processes -->
    <path class="so-arch" d={`M110 246 Q${M} 222 550 246`}></path>
    <ellipse class="so-bone" cx="566" cy="250" rx="26" ry="15"></ellipse>
    <ellipse class="so-bone" cx="94" cy="250" rx="26" ry="15"></ellipse>
    <circle cx={M} cy="231" r="9" fill="var(--t-bone)"></circle>

    <!-- axis (C2): laminae and large spinous process -->
    <path class="so-arch" d={`M180 300 Q${M} 286 480 300`}></path>
    <path class="so-bone" d={`M${M - 20} 292 L${M + 20} 292 L${M + 24} 344 L${M + 6} 356 L${M} 348 L${M - 6} 356 L${M - 24} 344 Z`}></path>

    <line class="so-mid" x1={M} y1="30" x2={M} y2="420"></line>

    <!-- suboccipital triangle (right) -->
    <polygon class="so-tri" points="458,158 365,292 544,242"></polygon>

    <!-- muscles, both sides -->
    {
      [undefined, mirror].map((t) => (
        <g transform={t}>
          <polygon class="so-mus" points={`${M + 4},226 ${M + 18},224 390,150 344,152`} />
          <polygon class="so-mus" points={`${M + 14},298 ${M + 26},300 470,158 410,150`} />
          <polygon class="so-mus" points="548,236 578,238 528,128 474,138" />
          <polygon class="so-mus" points={`${M + 22},304 ${M + 24},330 562,262 552,244`} />
        </g>
      ))
    }

    <!-- vertebral artery (V3) along the posterior arch, then through the atlanto-occipital membrane -->
    <path class="so-art" d={`M566 250 Q480 228 404 230 Q388 230 382 222`}></path>
    <circle cx="382" cy="220" r="5" fill="var(--t-artery)"></circle>

    <!-- suboccipital nerve (C1 dorsal ramus), between artery and arch, to the three muscles -->
    <path class="so-nerve" d="M440 238 L444 246"></path>
    <path class="so-nerve" d="M444 246 Q430 216 420 190"></path>
    <path class="so-nerve" d="M444 246 Q480 214 506 184"></path>
    <path class="so-nerve" d="M444 246 Q456 262 470 276"></path>

    <!-- greater occipital nerve (C2 dorsal ramus): around the lower border of obliquus capitis inferior, then up -->
    <path class="so-gon" d="M436 346 Q376 344 368 306 Q362 250 372 186 Q378 120 392 52"></path>

    <!-- leader lines -->
    <g stroke="var(--muted)" stroke-width="1">
      <line x1="634" y1="64" x2="560" y2="90"></line>
      <line x1="634" y1="112" x2="528" y2="160"></line>
      <line x1="634" y1="160" x2="486" y2="206"></line>
      <line x1="634" y1="208" x2="520" y2="236"></line>
      <line x1="634" y1="248" x2="450" y2="252"></line>
      <line x1="634" y1="288" x2="590" y2="256"></line>
      <line x1="634" y1="326" x2="500" y2="282"></line>
      <line x1="634" y1="366" x2="430" y2="346"></line>
      <line x1="634" y1="404" x2={M + 24} y2="340"></line>
      <line x1="26" y1="120" x2="304" y2="186"></line>
      <line x1="26" y1="166" x2="74" y2="186"></line>
      <line x1="26" y1="206" x2="262" y2="224"></line>
      <line x1="26" y1="246" x2="150" y2="240"></line>
      <line x1="26" y1="292" x2="190" y2="298"></line>
    </g>

    <!-- labels (right side) -->
    <Label x={640} y={68} to="skull">Occipital bone</Label>
    <Label x={640} y={116} size="sm">Obliquus capitis superior</Label>
    <Label x={640} y={164} to="suboccipital-triangle">Suboccipital triangle</Label>
    <Label x={640} y={212} to="vertebral-artery">Vertebral artery (V3)</Label>
    <Label x={640} y={246} size="sm">Suboccipital nerve</Label>
    <Label x={640} y={260} size="sm">(C1 dorsal ramus)</Label>
    <Label x={640} y={292} to="atlas-and-axis">Transverse process of atlas</Label>
    <Label x={640} y={330} size="sm">Obliquus capitis inferior</Label>
    <Label x={640} y={364} to="greater-occipital-nerve">Greater occipital nerve</Label>
    <Label x={640} y={378} size="sm">(C2 dorsal ramus)</Label>
    <Label x={640} y={408} size="sm">Spinous process of axis (C2)</Label>

    <!-- labels (left side) -->
    <Label x={20} y={124} anchor="end" size="sm">Rectus capitis posterior minor</Label>
    <Label x={20} y={170} anchor="end" size="sm" to="skull">Mastoid process</Label>
    <Label x={20} y={210} anchor="end" size="sm">Rectus capitis posterior major</Label>
    <Label x={20} y={250} anchor="end" to="atlas-and-axis">Posterior arch of atlas</Label>
    <Label x={20} y={296} anchor="end" size="sm">Lamina of axis</Label>

    <Label x={-190} y={40} size="sm">Posterior view · trapezius,</Label>
    <Label x={-190} y={54} size="sm">splenius and semispinalis</Label>
    <Label x={-190} y={68} size="sm">capitis (roof) removed</Label>
    <Label x={-190} y={420} size="sm">Not to scale</Label>
  </svg>
</div>
<p class="scroll-hint">Swipe sideways to see the whole diagram →</p>
