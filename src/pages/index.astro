---
import Base from '../layouts/Base.astro';
import { loadAtlas, regionUrl, url } from '../lib/atlas';

const atlas = await loadAtlas();
const count = (id: string) => atlas.structures.filter((s) => s.data.region === id).length;
const quizCount = atlas.structures.reduce((n, s) => n + s.data.quiz.length, 0);
const cardCount = atlas.structures.reduce((n, s) => n + s.data.flashcards.length, 0);
---

<Base title="Anatomy Atlas" description="Interactive regional human anatomy atlas for PA students.">
  <div class="hero">
    <h1>Regional Anatomy Atlas</h1>
    <p>
      Every structure has core anatomy, clinical correlations, imaging, physical exam, and a self-quiz, all
      cross-linked. Press <code>/</code> or tap Search to jump to any structure.
    </p>
    <div class="stats">
      <span><b>{atlas.structures.length}</b> structures</span>
      <span><b>{quizCount}</b> questions</span>
      <span><b>{cardCount}</b> flashcards</span>
      <span><a href={url('review/')}><b>{atlas.verifyFlags.length}</b> verify flags</a></span>
    </div>
    <p class="btn-row">
      <a class="btn primary" href={url('quiz/')}>Start a quiz</a>
      <a class="btn" href={url('flashcards/')}>Study flashcards</a>
      <a class="btn" href={url('systems/')}>By body system</a>
      <a class="btn" href={url('localizer/')}>Lesion localizer</a>
      <a class="btn" href={url('roots/')}>Nerve root map</a>
      <a class="btn" href={url('cases/')}>Clinical cases</a>
    </p>
  </div>

  <div class="grid">
    {
      atlas.regions.map((r) => (
        <a class="card" href={regionUrl(r.id)}>
          <h3>{r.data.name}</h3>
          <p>{r.data.blurb}</p>
          <p class="small" style="margin-top:8px">
            {count(r.id) ? `${count(r.id)} entries` : 'Coming soon'}
          </p>
        </a>
      ))
    }
  </div>

  <section class="offline-box" id="offline-box" aria-labelledby="offline-h">
    <h2 id="offline-h">Offline use</h2>
    <p class="muted" id="offline-status">
      Pages you open are saved on this device automatically. Save everything now to study without an internet connection.
    </p>
    <p class="btn-row">
      <button type="button" class="btn" id="save-pages" disabled>Save all pages</button>
      <button type="button" class="btn" id="save-all" disabled>Save pages and images</button>
    </p>
    <div class="meter" id="save-meter" hidden aria-hidden="true"><span></span></div>
    <p class="small muted" id="save-msg" aria-live="polite"></p>
  </section>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const base = document.body.dataset.base ?? '/';
  const KEY = 'atlas.offline';
  const mb = (n: number) => `${Math.max(1, Math.round(n / 1e6))} MB`;
  const pagesBtn = $('save-pages') as HTMLButtonElement;
  const allBtn = $('save-all') as HTMLButtonElement;

  interface OfflineList {
    version: string;
    pages: string[];
    pagesBytes: number;
    images: string[];
    imagesBytes: number;
  }

  function lastSaved() {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? 'null') as { t: number; images: boolean } | null;
    } catch {
      return null;
    }
  }

  async function save(list: OfflineList, withImages: boolean) {
    const urls = [...list.pages, ...(withImages ? list.images : [])].map((p) => base + p);
    pagesBtn.disabled = allBtn.disabled = true;
    const meter = $('save-meter');
    meter.hidden = false;
    const bar = meter.querySelector('span') as HTMLElement;
    try {
      await navigator.storage?.persist?.();
    } catch {}
    const cache = await caches.open('atlas-runtime');
    let done = 0;
    let failed = 0;
    const next = async () => {
      while (urls.length) {
        const u = urls.shift()!;
        try {
          const res = await fetch(u, { cache: 'no-cache' });
          if (res.ok && !res.redirected) await cache.put(u, res);
          else failed++;
        } catch {
          failed++;
        }
        done++;
        bar.style.width = `${Math.round((100 * done) / total)}%`;
        $('save-msg').textContent = `Saving… ${done} of ${total}`;
      }
    };
    const total = urls.length;
    await Promise.all(Array.from({ length: 6 }, next));
    if (failed) {
      $('save-msg').textContent = `Saved ${total - failed} of ${total} files; ${failed} failed. Check your connection and try again.`;
    } else {
      $('save-msg').textContent = `Done — ${withImages ? 'all pages and images are' : 'all pages are'} saved for offline use.`;
      try {
        localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), images: withImages }));
      } catch {}
    }
    pagesBtn.disabled = allBtn.disabled = false;
    showStatus();
  }

  function showStatus() {
    const s = lastSaved();
    if (s)
      $('offline-status').textContent = `Last saved ${new Date(s.t).toLocaleDateString()} (${
        s.images ? 'pages and images' : 'pages only'
      }). Save again after the atlas is updated to refresh your offline copy.`;
  }

  if (!('caches' in window) || !('serviceWorker' in navigator)) {
    $('offline-status').textContent = "This browser doesn't support offline saving.";
  } else {
    showStatus();
    fetch(base + 'offline.json')
      .then((r) => r.json())
      .then((list: OfflineList) => {
        pagesBtn.textContent = `Save all pages (${mb(list.pagesBytes)})`;
        allBtn.textContent = `Save pages and images (${mb(list.pagesBytes + list.imagesBytes)})`;
        pagesBtn.disabled = allBtn.disabled = false;
        pagesBtn.onclick = () => save(list, false);
        allBtn.onclick = () => save(list, true);
      })
      .catch(() => {
        $('save-msg').textContent = 'Offline saving is available on the published site.';
      });
  }
</script>
