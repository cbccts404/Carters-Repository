---
import Base from '../layouts/Base.astro';
import { loadAtlas, structureUrl, url } from '../lib/atlas';
const atlas = await loadAtlas();
const images = [...atlas.images.values()].sort((a, b) => a.data.title.localeCompare(b.data.title));
const usedBy = (id: string) => atlas.structures.filter((s) => s.data.images.some((i) => i.image === id));
---

<Base title="Image credits" description="Sources and licenses for every image in the atlas.">
  <div class="hero">
    <h1>Image credits &amp; licenses</h1>
    <p>
      This atlas only uses public-domain images, mainly plates from <em>Gray's Anatomy of the Human Body</em> (20th
      ed., 1918) hosted on Wikimedia Commons, plus original SVG schematics made for this project. The build
      rejects any image whose license isn't public domain or CC0.
    </p>
  </div>
  {
    images.length ? (
      <ul class="list credits">
        {images.map((i) => (
          <li>
            <div class="credit">
              <a href={url(i.data.file)}><img src={url(i.data.file)} alt={i.data.alt} loading="lazy" /></a>
              <div>
                <strong>{i.data.title}</strong>
                <div class="small">
                  {i.data.author}{i.data.work && <>, <em>{i.data.work}</em></>}. <a href={i.data.source} rel="noopener">Source</a>
                </div>
                <div class="small muted">
                  {i.data.license}{i.data.licenseNote && <> · {i.data.licenseNote}</>}
                </div>
                <div class="small">
                  Used in:{' '}
                  {usedBy(i.id).map((s, n) => (
                    <>
                      {n > 0 && ', '}
                      <a href={structureUrl(s)}>{s.data.name}</a>
                    </>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">No images added yet.</p>
    )
  }
</Base>
